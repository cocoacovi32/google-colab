import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Scenario values based on the previously computed variables
targeted_cust = targeted_customers  # 3,864 customers scaled
true_churners = true_churners_in_target
avg_arpu = avg_arpu_target
horizon_mo = RETENTION_HORIZON_MO
margin = GROSS_MARGIN
save_rate = SAVE_RATE # 25%

saved_cust = true_churners * save_rate
retained_gm = saved_cust * avg_arpu * horizon_mo * margin

# Test various incentive values
incentive_options = [20, 25, 30, 35, 40, 45, 50, 60]
sensitivity_results = []

for incentive in incentive_options:
    total_cost = targeted_cust * incentive
    net_impact = retained_gm - total_cost
    roi_pct = (net_impact / total_cost) * 100 if total_cost > 0 else 0.0
    
    sensitivity_results.append({
        'Incentive Cost ($)': incentive,
        'Total Campaign Cost': total_cost,
        'Net Financial Impact': net_impact,
        'ROI (%)': roi_pct
    })

sens_df = pd.DataFrame(sensitivity_results)

print("--- SENSITIVITY ANALYSIS BY INCENTIVE COST (SAVE RATE = 25%) ---")
display(sens_df.style.format({
    'Incentive Cost ($)': '${:,.0f}',
    'Total Campaign Cost': '${:,.0f}',
    'Net Financial Impact': '${:,.0f}',
    'ROI (%)': '{:.1f}%'
}))

# Visualizing the incentive cost vs ROI trade-off
fig, ax1 = plt.subplots(figsize=(10, 5))
sns.lineplot(data=sens_df, x='Incentive Cost ($)', y='Net Financial Impact', marker='o', color='#0d9488', ax=ax1, linewidth=2.5)
ax1.set_ylabel('Net Financial Impact ($)', color='#0d9488')
ax1.tick_params(axis='y', labelcolor='#0d9488')
ax1.set_xlabel('Incentive Cost per Targeted Customer ($)')
ax1.set_title('Financial Impact & ROI Sensitivity to Incentive Costs', fontsize=14, fontweight='bold', pad=15)

ax2 = ax1.twinx()
sns.lineplot(data=sens_df, x='Incentive Cost ($)', y='ROI (%)', marker='s', color='#dc2626', ax=ax2, linewidth=2.5, linestyle='--')
ax2.set_ylabel('Campaign ROI (%)', color='#dc2626')
ax2.tick_params(axis='y', labelcolor='#dc2626')
