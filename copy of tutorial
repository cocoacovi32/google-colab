ax.legend()
plt.tight_layout()
plt.savefig('chart1_handset_churn.png', dpi=300)
plt.show()

# Chart 2: Top-Decile Churn Lift & Cumulative Capture
lift_df = eval_df[['actual_churn', 'churn_prob']].copy()
lift_df['risk_decile'] = (
    pd.qcut(lift_df['churn_prob'], q=10, labels=False, duplicates='drop') + 1
)
lift_df['risk_rank'] = 11 - lift_df['risk_decile']
