import os
from pathlib import Path

from google.colab import drive
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    f1_score,
    precision_score,
    recall_score,
    roc_auc_score,
)
from sklearn.model_selection import train_test_split
from xgboost import XGBClassifier

pd.set_option('display.max_columns', 120)
sns.set_theme(style='whitegrid', context='talk')

# ------------------------------------------------------------------------------
# 1. Mount Drive & Auto-Locate telecom/Client.csv and telecom/Record.csv
# ------------------------------------------------------------------------------
try:
    drive.mount('/content/drive', force_remount=False)
except Exception as e:
    print("Drive mount skipped or already mounted.")

search_roots = [
    Path('/content/telecom'),
    Path('/content/drive/MyDrive'),
    Path('/content/drive'),
    Path('/content'),
]

work_dir = None
client_path = None
record_path = None

for root in search_roots:
  if not root.exists():
    continue
  if root.name == 'telecom' and (root / 'Client.csv').exists() and (root / 'Record.csv').exists():
    client_path = root / 'Client.csv'
    record_path = root / 'Record.csv'
    work_dir = root.parent
    break
  for c_file in root.rglob('Client.csv'):
    r_file = c_file.parent / 'Record.csv'
    if r_file.exists():
      client_path = c_file
      record_path = r_file
      work_dir = c_file.parent.parent
      break
  if client_path:
    break

if not client_path or not record_path:
  raise FileNotFoundError(
      'Could not find Client.csv and Record.csv inside a telecom/ folder. '
      'Check your Google Drive path or upload telecom/Client.csv and'
      ' telecom/Record.csv.'
  )

os.chdir(work_dir)
print(f'Working directory set to: {os.getcwd()}')
print(f'Found Client.csv: {client_path}')
print(f'Found Record.csv: {record_path}')

# ------------------------------------------------------------------------------
# 2. Load & Merge Source Tables
# ------------------------------------------------------------------------------
client = pd.read_csv(client_path)
record = pd.read_csv(record_path)

# Make column types consistent and merge
record['Customer_ID'] = record['Customer_ID'].astype(str)
client['Customer_ID'] = client['Customer_ID'].astype(str)

df = record.merge(client, on='Customer_ID', how='inner')
print(f'\nMerged dataset shape: {df.shape}')
print('Target (churn) distribution:')
print(df['churn'].value_counts(dropna=False))

# Ensure target is numeric
df['churn'] = pd.to_numeric(df['churn'], errors='coerce')
df = df.dropna(subset=['churn'])
df['churn'] = df['churn'].astype(int)
print(df['churn'].value_counts(normalize=True).round(4))

# ------------------------------------------------------------------------------
# 3. Exploratory Data Analysis Summaries
# ------------------------------------------------------------------------------
# Ensure relevant columns are numeric
df['eqpdays'] = pd.to_numeric(df['eqpdays'], errors='coerce')
df['change_mou'] = pd.to_numeric(df['change_mou'], errors='coerce')
df['months'] = pd.to_numeric(df['months'], errors='coerce')
df['mou_Mean'] = pd.to_numeric(df['mou_Mean'], errors='coerce')
df['change_rev'] = pd.to_numeric(df['change_rev'], errors='coerce')
df['rev_Mean'] = pd.to_numeric(df['rev_Mean'], errors='coerce')

stayed_eqp = df.loc[df['churn'] == 0, 'eqpdays']
churned_eqp = df.loc[df['churn'] == 1, 'eqpdays']

print('\n--- EDA SUMMARY ---')
print(f'Mean handset age (stayed):  {stayed_eqp.mean():.1f} days')
print(f'Mean handset age (churned): {churned_eqp.mean():.1f} days')
print(
    'Median monthly minutes change (change_mou) — stayed:'
    f" {df.loc[df['churn'] == 0, 'change_mou'].median():.1f}, churned:"
    f" {df.loc[df['churn'] == 1, 'change_mou'].median():.1f}"
)

# ------------------------------------------------------------------------------
# 4. Preprocessing & Actionable Feature Engineering
# ------------------------------------------------------------------------------
df_feat = df.drop(columns=['Customer_ID']).copy()

# Drop columns with > 40% missing values (keep target 'churn' untouched)
missing_pct = df_feat.drop(columns=['churn']).isna().mean()
high_missing_cols = missing_pct[missing_pct > 0.40].index.tolist()
df_feat = df_feat.drop(columns=high_missing_cols)
print(
    f'\nDropped {len(high_missing_cols)} columns with >40% missingness:'
    f' {high_missing_cols}'
)


# Safe division helper to prevent division-by-zero or infinities
def safe_div(num, den):
  den_clean = den.replace(0, np.nan)
  return (num / den_clean).replace([np.inf, -np.inf], np.nan).fillna(0.0)


# Actionable business & behavioral features
if {'eqpdays', 'months'}.issubset(df_feat.columns):
  df_feat['eqp_tenure_ratio'] = safe_div(
      df_feat['eqpdays'], df_feat['months'] * 30.0
  )

if {'change_mou', 'mou_Mean'}.issubset(df_feat.columns):
  df_feat['rel_mou_change'] = safe_div(df_feat['change_mou'], df_feat['mou_Mean'])

if {'change_rev', 'rev_Mean'}.issubset(df_feat.columns):
  df_feat['rel_rev_change'] = safe_div(df_feat['change_rev'], df_feat['rev_Mean'])

if {'drop_vce_Mean', 'blck_vce_Mean', 'attempt_Mean'}.issubset(df_feat.columns):
  df_feat['drop_vce_Mean'] = pd.to_numeric(df_feat['drop_vce_Mean'], errors='coerce')
  df_feat['blck_vce_Mean'] = pd.to_numeric(df_feat['blck_vce_Mean'], errors='coerce')
  df_feat['attempt_Mean'] = pd.to_numeric(df_feat['attempt_Mean'], errors='coerce')
  df_feat['fail_call_rate'] = safe_div(
      df_feat['drop_vce_Mean'].fillna(0) + df_feat['blck_vce_Mean'].fillna(0),
      df_feat['attempt_Mean'],
  )

if {'ovrrev_Mean', 'rev_Mean'}.issubset(df_feat.columns):
  df_feat['ovrrev_Mean'] = pd.to_numeric(df_feat['ovrrev_Mean'], errors='coerce')
  df_feat['overage_rev_share'] = safe_div(
      df_feat['ovrrev_Mean'], df_feat['rev_Mean']
  )

# Convert string/object columns to pandas 'category' so XGBoost handles NaNs & categories natively
cat_cols = df_feat.select_dtypes(include=['object', 'string']).columns.tolist()
for col in cat_cols:
  df_feat[col] = df_feat[col].astype('category')

print(f'Feature-engineered dataset shape: {df_feat.shape}')

# ------------------------------------------------------------------------------
# 5. Train / Test Split & XGBoost Classifier
# ------------------------------------------------------------------------------
X = df_feat.drop(columns=['churn'])
y = df_feat['churn'].astype(int)

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42, stratify=y
)

model = XGBClassifier(
    n_estimators=400,
    learning_rate=0.03,
    max_depth=5,
    subsample=0.8,
    colsample_bytree=0.8,
    enable_categorical=True,
    eval_metric='logloss',
    random_state=42,
    n_jobs=-1,
)

model.fit(X_train, y_train)

y_pred = model.predict(X_test)
y_proba = model.predict_proba(X_test)[:, 1]

print('\n--- MODEL EVALUATION (HELD-OUT TEST SET) ---')
print(f'Accuracy:  {accuracy_score(y_test, y_pred):.4f}')
print(f'ROC-AUC:   {roc_auc_score(y_test, y_proba):.4f}')
print(f'Precision: {precision_score(y_test, y_pred):.4f}')
print(f'Recall:    {recall_score(y_test, y_pred):.4f}')
print(f'F1 Score:  {f1_score(y_test, y_pred):.4f}\n')
print(
    classification_report(y_test, y_pred, target_names=['Stayed (0)', 'Churned (1)'])
)

# Top 15 features by Gain
importances = pd.Series(
    model.feature_importances_, index=X.columns
).sort_values(ascending=False)
print('Top 15 Features by Importance:')
print(importances.head(15).round(4))

# ------------------------------------------------------------------------------
# 6. Quantified Business Proposal & ROI Calculation
# ------------------------------------------------------------------------------
eval_df = pd.DataFrame(index=X_test.index)
eval_df['actual_churn'] = y_test.values
eval_df['churn_prob'] = y_proba
eval_df['rev_Mean'] = X_test['rev_Mean'] if 'rev_Mean' in X_test.columns else 0.0
eval_df['eqpdays'] = X_test['eqpdays'] if 'eqpdays' in X_test.columns else 0.0
eval_df['change_mou'] = (
    X_test['change_mou'] if 'change_mou' in X_test.columns else 0.0
)
eval_df['risk_percentile'] = eval_df['churn_prob'].rank(pct=True)

# Target segment: Top 15% highest churn risk + monthly revenue >= $40 + handset age > 365 days
target_mask = (
    (eval_df['risk_percentile'] >= 0.85)
    & (eval_df['rev_Mean'] >= 40.0)
    & (eval_df['eqpdays'] > 365.0)
)
target_group = eval_df[target_mask]

# Scale test set (25,000 rows) to full 100,000-customer base
scale_factor = len(df) / len(X_test)

# Transparent business assumptions (adjust to match your proposal)
INTERVENTION_COST = (
    35.0  # $35 handset upgrade voucher / bill credit per targeted user
)
SAVE_RATE = 0.25  # 25% of targeted true churners retained by offer
RETENTION_HORIZON_MO = 12  # 12 months of retained service post-intervention
GROSS_MARGIN = 0.65  # 65% telecom gross margin

targeted_customers = len(target_group) * scale_factor
true_churners_in_target = target_group['actual_churn'].sum() * scale_factor
target_churn_rate = (
    target_group['actual_churn'].mean() if len(target_group) > 0 else 0.0
)
avg_arpu_target = (
    target_group['rev_Mean'].mean() if len(target_group) > 0 else 0.0
)

saved_customers = true_churners_in_target * SAVE_RATE
retained_gross_profit = (
    saved_customers * avg_arpu_target * RETENTION_HORIZON_MO * GROSS_MARGIN
)
campaign_cost = targeted_customers * INTERVENTION_COST
net_financial_impact = retained_gross_profit - campaign_cost
roi_pct = (
    (net_financial_impact / campaign_cost) * 100 if campaign_cost > 0 else 0.0
)

print('\n--- QUANTIFIED BUSINESS PROPOSAL (SCALED TO 100K BASE) ---')
print(
    'Targeted Segment (Top 15% Risk + ARPU >= $40 + eqpdays > 365):'
    f' {targeted_customers:,.0f} customers'
)
print(
    'Actual Churn Rate in Target Segment:                          '
    f' {target_churn_rate*100:.1f}% ({true_churners_in_target:,.0f} churners)'
)
print(
    'Average Monthly Revenue (ARPU) in Target Segment:             '
    f' ${avg_arpu_target:.2f}'
)
print(
    'Estimated Customers Saved (25% save rate):                    '
    f' {saved_customers:,.0f}'
)
print(
    '12-Month Retained Gross Margin (65% margin):                  '
    f' ${retained_gross_profit:,.0f}'
)
print(
    'Total Campaign Cost ($35 voucher/customer):                   '
    f' ${campaign_cost:,.0f}'
)
print(
    'Net Financial Impact (Profit - Cost):                         '
    f' ${net_financial_impact:,.0f}'
)
print(f'Campaign ROI:                                                 {roi_pct:.1f}%')

# Sensitivity table across save rates (15%, 25%, 35%)
print('\n--- SENSITIVITY ANALYSIS BY RETENTION SAVE RATE ---')
for sr in [0.15, 0.25, 0.35]:
  s_cust = true_churners_in_target * sr
  s_gp = s_cust * avg_arpu_target * RETENTION_HORIZON_MO * GROSS_MARGIN
  s_net = s_gp - campaign_cost
  s_roi = (s_net / campaign_cost) * 100 if campaign_cost > 0 else 0.0
  print(
      f'Save Rate {sr*100:.0f}% -> Saved: {s_cust:,.0f} | Gross Margin:'
      f' ${s_gp:,.0f} | Net Impact: ${s_net:,.0f} | ROI: {s_roi:.1f}%'
  )

# ------------------------------------------------------------------------------
# 7. Presentation-Ready Charts (Saved as 300 DPI PNGs)
# ------------------------------------------------------------------------------
# Chart 1: Churn Rate by Handset Age Bucket
eqp_bins = [-100, 180, 365, 540, 730, 10000]
eqp_labels = ['0-6 mo', '6-12 mo', '12-18 mo', '18-24 mo', '24+ mo']
df_plot = df[['eqpdays', 'churn', 'change_mou']].copy()
df_plot['eqp_bucket'] = pd.cut(
    df_plot['eqpdays'], bins=eqp_bins, labels=eqp_labels
)
churn_by_eqp = (
    df_plot.groupby('eqp_bucket', observed=False)['churn'].mean() * 100
)
base_churn_pct = df_plot['churn'].mean() * 100

fig, ax = plt.subplots(figsize=(9, 5))
bars = sns.barplot(
    x=churn_by_eqp.index, y=churn_by_eqp.values, hue=churn_by_eqp.index, palette='Blues_d', ax=ax, legend=False
)
ax.axhline(
    base_churn_pct,
    color='#dc2626',
    linestyle='--',
    linewidth=1.5,
    label=f'Baseline Churn ({base_churn_pct:.1f}%)',
)
ax.set_title(
    'Churn Risk Rises Across Aging Handset Buckets',
    fontsize=14,
