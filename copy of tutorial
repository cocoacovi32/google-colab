ax.set_xlabel('Handset Age (eqpdays)')
ax.set_ylabel('Churn Rate (%)')
ax.set_ylim(0, max(churn_by_eqp.values.max(), base_churn_pct) * 1.25)
for bar in bars.patches:
  h = bar.get_height()
  if not np.isnan(h):
    ax.text(
        bar.get_x() + bar.get_width() / 2,
